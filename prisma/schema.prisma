// Prisma schema — Somalia Trading Store
// Phase 2: Category and Product only (entities that don't depend on auth).
// See docs/IMPLEMENTATION_PLAN.md for what each later phase adds.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum PurchasingMode {
  BUY_ONLINE
  QUOTE_ONLY
  BOTH
}

enum Availability {
  IN_STOCK
  LIMITED
  OUT_OF_STOCK
  MADE_TO_ORDER
}

// Phase 5: Inventory. Kept as a small, free-form-friendly enum per
// docs/IMPLEMENTATION_PLAN.md Phase 5 ("free text or a small enum — your call, keep it
// simple") — MANUAL_ADJUSTMENT covers ad-hoc admin corrections, RESTOCK/CORRECTION give
// admins meaningful categories to pick from, and ORDER_PLACED/ORDER_CANCELLED are the
// hooks Phase 8 (checkout) will use when it starts decrementing stock on order creation.
// A free-text `note` field on InventoryTransaction covers anything an enum can't.
enum InventoryChangeReason {
  MANUAL_ADJUSTMENT
  RESTOCK
  CORRECTION
  ORDER_PLACED
  ORDER_CANCELLED
}

model Category {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  description String
  shortDescription String
  image       String
  heroImage   String
  accentColor String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  parentId String?
  parent   Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: Restrict)
  children Category[] @relation("CategoryHierarchy")

  products Product[]

  translations CategoryTranslation[]

  @@index([parentId])
}

// Phase 17 (i18n): locale-specific overrides for Category's customer-facing text.
// English content stays on the base Category row (canonical default-locale fallback,
// never null) — this table only holds additional locales. A missing row for a given
// locale means "not yet translated"; the read path falls back to the base English
// fields, never to a blank/undefined value. `slug` is an optional per-locale URL
// override; when absent, routing falls back to the base Category.slug (see
// resolve-translation.ts and the routing layer for the fallback chain).
model CategoryTranslation {
  id         String   @id @default(cuid())
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  locale String // validated against src/config/i18n.ts `locales` at the app layer —
  // kept as String, not an enum, so adding a locale never requires a migration.

  name             String
  description      String
  shortDescription String
  slug             String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([categoryId, locale])
  @@unique([locale, slug])
  @@index([locale])
}

model Product {
  id          String   @id @default(cuid())
  slug        String   @unique
  sku         String?  @unique
  name        String
  description String
  shortDescription String

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  // Phase 4: free-text facet within a category (e.g. "Doors", "Rods"). Not a separate
  // table/relation — the old demo data modeled this as a plain string per product, and
  // Category nesting (parentId/children) already covers the "real subcategory as its own
  // entity" case if that's ever needed. Kept as a simple field to preserve the existing
  // filter/facet UI (src/config/filters.ts) with a minimal, non-breaking schema change.
  subcategory String?

  price           Decimal @db.Decimal(12, 2)
  compareAtPrice  Decimal? @db.Decimal(12, 2)
  currency        String  @default("USD")
  priceUnit       String?

  images         String[]
  specifications Json     @default("{}")
  tags           String[]

  purchasingMode PurchasingMode @default(BUY_ONLINE)
  availability   Availability   @default(IN_STOCK)
  featured       Boolean        @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  inventory             Inventory?
  inventoryTransactions InventoryTransaction[]

  // Phase 7: Cart & Wishlist.
  cartItems     CartItem[]
  wishlistItems WishlistItem[]

  // Phase 8: Checkout & Order Placement. Reference-only — see OrderItem's comment.
  orderItems OrderItem[]

  // Phase 11: Quote Requests. Reference-only — see QuoteItem's own comment.
  quoteItems QuoteItem[]

  reviews Review[]

  // Product variants (size/color etc.) — optional. A product with zero variants
  // behaves exactly as before this feature was added (single SKU, Inventory keyed by
  // productId) — see ProductVariant's own comment for why variant stock/cart/order
  // lines are a deliberately PARALLEL set of models rather than retrofitting
  // Inventory/CartItem/OrderItem to be nullable-variant-aware.
  variants ProductVariant[]

  translations ProductTranslation[]

  @@index([categoryId])
  @@index([featured])
  @@index([availability])
  @@index([subcategory])
}

// Phase 17 (i18n): locale-specific overrides for Product's customer-facing text. Same
// pattern/rationale as CategoryTranslation above — English stays on the base Product
// row as the canonical fallback; this table is additive-only. Deliberately NOT flat
// per-locale columns (nameSo, nameAr, ...): a translation table lets a new locale be
// added as admin-authored rows with zero schema migration, whereas flat columns would
// require a migration + new admin form fields for every future language.
//
// IMPORTANT: this table only affects the *live* catalog. OrderItem.productName is an
// immutable English snapshot captured at order-creation time (docs/DECISIONS.md D-007)
// and must never be swapped for a live/localized lookup — order history stays in
// whatever language the product was in when the order was placed.
model ProductTranslation {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  locale String

  name             String
  description      String
  shortDescription String
  slug             String? // optional locale-specific slug override; falls back to
  // the base Product.slug when absent — see the note on nullable-slug uniqueness in
  // resolve-translation.ts. Not checked against other products' base English slugs,
  // only deduped within this table (@@unique([locale, slug]) below).
  seoTitle       String?
  seoDescription String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([productId, locale])
  @@unique([locale, slug])
  @@index([locale])
}

// Product variants (size/color/etc.) — e.g. a shirt in Black/Small, Black/Medium,
// Brown/Large. Deliberately a PARALLEL system alongside the existing non-variant
// Product/Inventory/CartItem/OrderItem models, rather than retrofitting those to carry
// a nullable variantId everywhere: the existing single-SKU catalog (Inventory.productId
// @unique, CartItem's @@unique([cartId, productId]), the atomic no-oversell UPDATE in
// inventoryRepository.applyAdjustment) is proven, tested, and must not regress for the
// majority of products that will never have variants. See VariantInventory/
// VariantInventoryTransaction/CartItem.variantId/OrderItem.variant* for the rest of
// this parallel path. `attributes` is structured JSON (e.g. {"size":"M","color":
// "Black"}) — same convention as Product.specifications — rather than normalized
// attribute rows, since there's no cross-product attribute filtering requirement today.
// `price` is a nullable override; null falls back to the parent Product.price at
// checkout time (never a client-supplied price — same pricing-integrity rule as
// OrderItem). Duplicate attribute combinations for the same product are prevented at
// the service layer (admin-facing catalog operation, not a customer-facing race like
// coupon usage, so a DB-level constraint on a JSON column isn't warranted here).
model ProductVariant {
  id         String  @id @default(cuid())
  sku        String  @unique
  attributes Json
  price      Decimal? @db.Decimal(12, 2)
  image      String?
  active     Boolean  @default(true)

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  inventory             VariantInventory?
  inventoryTransactions VariantInventoryTransaction[]
  cartItems             CartItem[]
  orderItems            OrderItem[]

  @@index([productId])
}

// Mirrors Inventory's exact shape and the same atomic no-oversell guarantee
// (variantInventoryRepository.applyAdjustment uses the identical conditional-UPDATE
// pattern as inventoryRepository.applyAdjustment) — kept as a parallel model rather
// than a nullable variantId on Inventory so the existing Inventory.productId @unique
// constraint (one row per non-variant product) never has to change.
model VariantInventory {
  id                String   @id @default(cuid())
  quantity          Int      @default(0)
  lowStockThreshold Int      @default(10)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  variantId String         @unique
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  transactions VariantInventoryTransaction[]
}

// Mirrors InventoryTransaction's exact shape (full audit ledger: actor, previous/
// adjustment/new quantity, reason, timestamp) for the variant stock path.
model VariantInventoryTransaction {
  id               String                @id @default(cuid())
  previousQuantity Int
  adjustment       Int
  newQuantity      Int
  reason           InventoryChangeReason
  note             String?
  createdAt        DateTime              @default(now())

  inventoryId String
  inventory   VariantInventory @relation(fields: [inventoryId], references: [id], onDelete: Cascade)

  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  actorId String
  actor   User   @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([inventoryId])
  @@index([variantId])
  @@index([actorId])
}

// Duplicate-checkout guard for order-creation paths that have no server Cart row to
// gate on (guest checkout, quote-to-order conversion — both call persistOrder with
// clearCart: false). Found via adversarial red-team testing: a RETURNING guest
// (existing isGuest User row) double-clicking checkout could create two separate
// orders, since nothing detected the second concurrent request as a duplicate
// (unlike the authenticated cart-checkout path, which the SAME testing pass found and
// fixed using the cart's own row count as an atomic gate — see order-service.ts
// persistOrder's cart-clear-first ordering).
//
// `key` is a per-checkout-attempt idempotency key (see order-service.ts
// resolveIdempotencyKey): the CLIENT generates one random key when a checkout page
// loads and reuses it across every "Place Order" click on that page — a genuine
// double-click sends the SAME key twice; navigating to a fresh checkout (a real,
// separate purchase) generates a NEW key. This is the only way to correctly
// distinguish "the same click, retried" from "the customer genuinely wants to buy the
// same items again" — a time-window-only guard (an earlier version of this fix)
// cannot: they are literally identical requests, indistinguishable by content or
// timing alone (a legitimate test — order-service.test.ts's "reuses the same guest
// User on a second order" — makes two back-to-back, byte-identical purchase
// requests). A request with no client-supplied key (an old/naive API caller) falls
// back to a deterministic hash of the request content, which still catches exact
// resubmissions but — correctly, since there's no other signal available — cannot
// tell two genuinely-repeated legitimate purchases apart from a duplicate.
//
// `@@unique([userId, key])`, NOT deleted after use. The atomic gate is a conditional
// `INSERT ... ON CONFLICT (userId, key) DO NOTHING RETURNING id` (see
// checkoutLockRepository.claim): the first request for a given (userId, key) pair
// wins and proceeds; any later request with the same pair claims nothing and is
// rejected as a duplicate — permanently, not just within a time window, since the
// same key should never legitimately repeat. This avoids the classic "INSERT ...
// WHERE NOT EXISTS" race (two concurrent transactions can both see NOT EXISTS as true
// under READ COMMITTED) by using the unique constraint's row-level lock as the actual
// serialization point, same principle as every other atomic-conditional-update in
// this codebase (Inventory.quantity, Coupon.timesUsed).
model CheckoutLock {
  id        String   @id @default(cuid())
  key       String
  createdAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, key])
}

// Phase 3: Authentication & Authorization.
// JWT session strategy (Credentials provider only) — no Account/Session/VerificationToken
// tables; see docs/DECISIONS.md D-004 and docs/IMPLEMENTATION_PLAN.md Phase 3.
model Role {
  id          String   @id @default(cuid())
  name        String   @unique
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users             User[]
  rolePermissions   RolePermission[]
}

model Permission {
  id        String   @id @default(cuid())
  key       String   @unique
  createdAt DateTime @default(now())

  rolePermissions RolePermission[]
}

model RolePermission {
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
}

// Admin User Management & RBAC. Scoped ONLY to admin-user-management actions
// (create/deactivate/reactivate/role-change/reset-password) — not a general-purpose
// app-wide audit system. `actor` uses onDelete: Restrict so an audit trail can never
// silently lose who performed an action; this never actually blocks anything in
// practice since users are only ever soft-deactivated, never hard-deleted.
model AuditLog {
  id         String   @id @default(cuid())
  actorId    String
  actor      User     @relation("AuditLogActor", fields: [actorId], references: [id], onDelete: Restrict)
  action     String   // "admin_user.create" | "admin_user.deactivate" | "admin_user.reactivate" |
                       // "admin_user.role_change" | "admin_user.reset_password"
  targetType String   // "User" (fixed value today, kept as a string for future reuse)
  targetId   String
  metadata   Json?    // e.g. { fromRole, toRole } — never passwords/hashes
  createdAt  DateTime @default(now())

  @@index([targetType, targetId])
  @@index([actorId])
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  // Nullable: guest-checkout orders (order-service.ts `createGuestOrder`) create a
  // User row with no password and no session — the account exists only to satisfy
  // Order.userId's foreign key and to give the guest an order history if they later
  // set a password via the normal forgot-password flow. `verifyPassword`/`authorize`
  // in auth.ts already reject login when passwordHash is null.
  passwordHash  String?
  name          String
  phone         String?
  emailVerified DateTime?
  isGuest       Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // i18n: explicit account-level language preference (requirement §54). String, not
  // an enum — validated against src/config/i18n.ts's `locales` at the app layer, same
  // pattern as ProductTranslation/CategoryTranslation.locale, so adding a new
  // supported language never needs a migration here. Nullable: no preference set yet
  // means "fall back to cookie/browser/geo resolution" (see src/i18n/resolve-locale.ts).
  preferredLocale String?

  // Admin User Management & RBAC. `active` gates `getCurrentSession` (session.ts) on
  // every request — a deactivated account loses admin access immediately, not just at
  // next login, since the JWT's role claim is otherwise frozen at sign-in. See
  // docs/DECISIONS.md for the session-revocation rationale.
  active             Boolean   @default(true)
  // Set on accounts created via /admin/users (temp password issued by another admin);
  // forces a change-password screen before any other admin route is reachable. Never
  // set on self-registered customer accounts.
  mustChangePassword Boolean   @default(false)
  lastLoginAt        DateTime?
  // Nullable: the seeded first super_admin and self-registered customers have no
  // creator. Staff accounts created via /admin/users always have one.
  createdById        String?
  createdBy          User?     @relation("UserCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdUsers       User[]    @relation("UserCreatedBy")

  roleId String
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Restrict)

  passwordResetTokens   PasswordResetToken[]
  inventoryTransactions InventoryTransaction[]
  variantInventoryTransactions VariantInventoryTransaction[]
  addresses             Address[]
  auditLogs             AuditLog[] @relation("AuditLogActor")
  checkoutLocks         CheckoutLock[]

  // Phase 7: Cart & Wishlist. 1:1 per user — simplest model that satisfies "a user has
  // one cart" / "a user has one wishlist"; both are created lazily on first use
  // (cart-service.ts / wishlist-service.ts getOrCreateForUser) rather than at
  // registration, so most users never get an empty row.
  cart     Cart?
  wishlist Wishlist?

  // Phase 8: Checkout & Order Placement.
  orders Order[]

  // Phase 9: Order Management. Nullable actor on both — see the history models' own
  // comments for why (system-authored initial rows have no actor).
  orderStatusHistoryActions   OrderStatusHistory[]
  paymentStatusHistoryActions PaymentStatusHistory[]

  // Phase 10: Refund/Return Workflow. Two distinct relations to RefundRequest (the
  // customer who requested vs. the admin who reviewed) plus the status-history actor —
  // named relations required since there's more than one FK from User to RefundRequest.
  refundRequestsMade                RefundRequest[]               @relation("RefundRequestsMade")
  refundRequestsReviewed             RefundRequest[]               @relation("RefundRequestsReviewed")
  refundRequestStatusHistoryActions RefundRequestStatusHistory[]

  // Phase 11: Quote Requests. Nullable — a quote may be submitted by a guest (no
  // userId at all, see Quote's own comment) rather than every quote having an owning
  // user. `quoteStatusHistoryActions` is the admin actor on QuoteStatusHistory rows
  // (nullable there too, for the system-authored initial NEW row).
  quotes                     Quote[]
  quoteStatusHistoryActions  QuoteStatusHistory[]

  // Phase 15: Notifications. In-app notifications addressed to this user — see the
  // Notification model's own comment.
  notifications Notification[]

  // Product reviews — one review per user per product (@@unique on Review), enforced
  // at the DB layer same as WishlistItem's duplicate-prevention pattern.
  reviews Review[]

  // Coupons/discounts. Used to enforce Coupon.perCustomerLimit — see
  // coupon-service.ts.
  couponRedemptions CouponRedemption[]

  @@index([roleId])
}

// Phase 6: Customer Account. Multiple addresses per user (e.g. home + office); Phase 8
// (checkout) will read `isDefault` to preselect a shipping address. Every read/write
// path (src/server/services/address-service.ts) must scope by the owning userId taken
// from the server-verified session — never a client-supplied userId — per
// docs/IMPLEMENTATION_PLAN.md cross-cutting standards and the Phase 6 IDOR requirement.
// No `postalCode` requirement — Somalia addressing doesn't always use one.
model Address {
  id            String   @id @default(cuid())
  recipientName String
  phone         String
  line1         String
  line2         String?
  city          String
  region        String?
  postalCode    String?
  country       String
  isDefault     Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Phase 5: Inventory. 1:1 with Product. `quantity` must never go negative — enforced
// both at the application layer (inventory-service.ts, atomic conditional UPDATE inside
// a transaction) and at the DB layer via a CHECK constraint. Prisma's schema DSL has no
// native syntax for arbitrary CHECK constraints at this version, so the constraint is
// added by hand-editing the generated migration.sql after `prisma migrate dev` — see
// prisma/migrations/<timestamp>_add_inventory/migration.sql and the note in
// docs/DECISIONS.md.
model Inventory {
  id                String   @id @default(cuid())
  quantity          Int      @default(0)
  lowStockThreshold Int      @default(10)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  productId String  @unique
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  transactions InventoryTransaction[]
}

// Full audit log of every stock change: who (actor), what product, previous/adjustment/
// new quantity, why (reason + optional free-text note), and when. Never mutated or
// deleted — one row per adjustment, per docs/IMPLEMENTATION_PLAN.md cross-cutting
// standards ("Inventory adjustments are logged with actor, previous quantity,
// adjustment, new quantity, reason, and timestamp").
model InventoryTransaction {
  id               String                @id @default(cuid())
  previousQuantity Int
  adjustment       Int
  newQuantity      Int
  reason           InventoryChangeReason
  note             String?
  createdAt        DateTime              @default(now())

  inventoryId String
  inventory   Inventory @relation(fields: [inventoryId], references: [id], onDelete: Cascade)

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  actorId String
  actor   User   @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([inventoryId])
  @@index([productId])
  @@index([actorId])
}

// Phase 8: Checkout & Order Placement.
// D-007 (docs/DECISIONS.md): no payment gateway is chosen yet, so every order is
// created PENDING/NOT_PAID, unconditionally, forever, in this phase. CONFIRMED/
// PROCESSING/SHIPPED/DELIVERED/CANCELLED and PAID/REFUNDED/FAILED exist here only as
// future-proofing for Phase 9/10 — nothing in Phase 8's checkout flow can ever produce
// them; order-service.createOrder hardcodes PENDING/NOT_PAID and nothing else writes
// to these fields yet.
enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  NOT_PAID
  PAID
  REFUNDED
  FAILED
}

// Order/OrderItem intentionally do NOT reuse CartItem's { productId, quantity } shape
// (docs/PROJECT_AUDIT.md data-integrity section) — an order must remain accurate
// forever even after the referenced Product's price/name/sku changes later. Shipping
// address is copied onto the Order as plain fields (not a live Address FK) for the same
// reason: editing/deleting the source Address later must never alter what a past order
// shows as "shipped to". `taxAmount`/`shippingAmount` are deliberately not modeled yet
// (D-008 — both deferred); `subtotal`/`total` are equal today by construction, kept as
// two fields so tax/shipping can be added later (`total = subtotal + tax + shipping`)
// without a breaking schema change.
model Order {
  id          String        @id @default(cuid())
  orderNumber String        @unique
  status      OrderStatus   @default(PENDING)
  paymentStatus PaymentStatus @default(NOT_PAID)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)

  // Shipping address snapshot — copied at order-creation time from the customer's
  // chosen Address (or inline input), never a live FK. See comment above.
  shippingRecipientName String
  shippingPhone         String
  shippingLine1         String
  shippingLine2         String?
  shippingCity          String
  shippingRegion        String?
  shippingPostalCode    String?
  shippingCountry       String

  subtotal Decimal @db.Decimal(12, 2)
  // D-008 resolved: flat-rate shipping (currently $0 / free shipping, configurable via
  // FLAT_SHIPPING_AMOUNT below) rather than a carrier/zone model — see docs/DECISIONS.md.
  // Kept as its own field (not folded into subtotal) so a future zone/carrier-based
  // calculation can replace the flat constant without a schema change.
  shippingAmount Decimal @default(0) @db.Decimal(12, 2)
  // Coupons/discounts. `couponCode` is a snapshot (the code as typed/normalized at
  // order-creation time), not a live FK to Coupon — same "never let a later change to
  // the referenced entity alter a historical order" principle as OrderItem's product
  // snapshot. Usage-limit accounting lives on CouponRedemption, not here.
  couponCode     String?
  discountAmount Decimal @default(0) @db.Decimal(12, 2)
  total    Decimal @db.Decimal(12, 2)
  currency String  @default("USD")

  customerNote String?

  // i18n: the customer's effective locale AT THE MOMENT of order creation (requirement
  // §31) — a snapshot, deliberately NOT a live read of User.preferredLocale, so a
  // customer changing their language preference later never rewrites which language
  // past transactional emails/invoices were (or should be) sent in. Nullable only
  // because orders created before this field existed have no historical value;
  // every new order always sets it (see order-service.ts persistOrder).
  customerLocale String?

  // Phase 9: Order Management. Admin-only working note — visible only in /admin/orders,
  // never surfaced to the customer. A single overwritable field, not a log: simpler than
  // a separate notes model, at the cost of losing history if an admin overwrites it. If a
  // running log ever becomes a real requirement, promote this to its own model then —
  // not needed for the "internal notes field" ask in the Phase 9 plan today.
  internalNote String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items         OrderItem[]
  statusHistory OrderStatusHistory[]
  paymentStatusHistory PaymentStatusHistory[]

  // Phase 10: Refund/Return Workflow. See RefundRequest's own comment — order-level,
  // so a single order may accumulate multiple requests over time (though only one may
  // be open/unresolved at once, enforced in refund-service.ts).
  refundRequests RefundRequest[]

  // Phase 11: Quote Requests. Reverse side of Quote.convertedOrderId — set only when
  // this order was created via quote-service.convertToOrder rather than normal
  // checkout. No FK columns live on Order itself for this; Quote holds the FK (see
  // Quote's own comment).
  convertedFromQuote Quote?

  // Coupons/discounts. At most one redemption per order (the checkout flow accepts
  // one coupon code per order, not stacked codes) — enforced by @@unique([orderId])
  // on CouponRedemption.
  couponRedemption CouponRedemption?

  // Phase 17: Performance. Added after auditing the actual query patterns that hit
  // this table — `status` and `paymentStatus` are both used as standalone filters in
  // `orderRepository.buildAdminWhere` (admin order list, /admin/orders) and in
  // `dashboardRepository.orderStatusCounts`'s groupBy; `createdAt` is the admin list's
  // default sort column AND the date-range filter used by
  // `orderRepository.adminFindMany`, `dashboardRepository.ordersCountInPeriod`/
  // `orderValueInPeriod`, and `reportRepository.productSales`/`ordersByCustomer`. Order
  // is the highest-write-volume table in the schema (one row per checkout, growing
  // forever, unlike the small bounded Category/Role tables), making it the one place
  // an index genuinely pays for itself rather than being speculative.
  @@index([userId])
  @@index([orderNumber])
  @@index([status])
  @@index([paymentStatus])
  @@index([createdAt])
}

// Phase 9: Order Management — full audit trail for `Order.status` changes, per
// docs/IMPLEMENTATION_PLAN.md Phase 9 ("full audit trail") and the same spirit as
// InventoryTransaction (cross-cutting standard: actor/previous/new/reason/timestamp).
// One row per transition, never mutated/deleted. `fromStatus` is null only for the
// very first row written at order creation (PENDING has no prior status); `actorId` is
// null for that same row (the system, not an admin, creates a PENDING order) and set
// for every admin-initiated change thereafter. Kept as its own model rather than a
// generic polymorphic "history" table — two small, clearly-named models
// (OrderStatusHistory / PaymentStatusHistory) are easier to query and reason about than
// one shared table with a discriminator column, for the two fields that need this today.
model OrderStatusHistory {
  id         String       @id @default(cuid())
  fromStatus OrderStatus?
  toStatus   OrderStatus
  note       String?
  createdAt  DateTime     @default(now())

  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  actorId String?
  actor   User?   @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([actorId])
}

// Phase 9: parallel audit trail for `Order.paymentStatus`. No code path in this phase
// (or any prior phase) ever changes paymentStatus — D-007, no payment gateway exists
// yet — so today this only ever gets the one row written at order creation
// (fromStatus: null, toStatus: NOT_PAID, actorId: null). It exists now, alongside
// OrderStatusHistory, so a future payment-gateway integration has an audit trail to
// write into from day one instead of retrofitting one later. Deliberately a SEPARATE
// model from OrderStatusHistory (not a shared table) — this is the same structural
// guardrail as the Order model itself keeping `status`/`paymentStatus` as two
// independent fields: nothing about this schema invites coupling the two histories
// together either.
model PaymentStatusHistory {
  id         String         @id @default(cuid())
  fromStatus PaymentStatus?
  toStatus   PaymentStatus
  note       String?
  createdAt  DateTime       @default(now())

  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  actorId String?
  actor   User?   @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([actorId])
}

// Every pricing/identity field here is a SNAPSHOT taken at order-creation time —
// productName/sku/unitPrice/lineTotal are never re-derived from the live Product row
// afterward (docs/IMPLEMENTATION_PLAN.md cross-cutting standards). `productId` is kept
// as a reference-only FK (e.g. for admins to jump to the current product page) — never
// the source of truth for what was actually purchased. onDelete: Restrict on the
// Product relation means a product that has ever been ordered can't be hard-deleted,
// which keeps that reference meaningful for as long as it exists.
model OrderItem {
  id String @id @default(cuid())

  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  productName String
  sku         String?
  unitPrice   Decimal @db.Decimal(12, 2)
  quantity    Int
  lineTotal   Decimal @db.Decimal(12, 2)

  // Variant snapshot — same "never re-read a live row for a historical order"
  // principle as productName/sku/unitPrice above. `variantId` is a reference-only FK
  // (like `productId`'s own comment describes) for admin convenience; `variantLabel`
  // is the actual historical record (e.g. "Black / Medium", rendered from the
  // variant's `attributes` at order-creation time) — it survives even if the variant
  // is later edited or deleted.
  variantId    String?
  variant      ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  variantLabel String?

  createdAt DateTime @default(now())

  @@index([orderId])
  @@index([productId])
  @@index([variantId])
}

// Phase 10: Refund/Return Workflow (spec §7; docs/DECISIONS.md D-007). This is a
// REQUEST workflow only — no payment gateway exists yet, so nothing here ever moves
// money or touches `Order.paymentStatus`. `RefundRequestStatus` is the request's own
// lifecycle (did we, as a business, agree the customer should get their money back)
// and is deliberately never written to `Order.paymentStatus` by any code path — see
// refund-service.ts. A genuine "has this actually been refunded in the real world"
// concept (`PaymentRefundStatus`) is intentionally NOT modeled yet: `Order.paymentStatus`
// already reserves a `REFUNDED` value for whenever a payment gateway exists (Phase 8
// schema comment), so adding a second, parallel, always-unset enum here would be pure
// scope creep with no code path that could ever set it — unlike Phase 9's
// PaymentStatusHistory, which existed to give a *future* gateway integration an audit
// trail to write into. There's no equivalent "write into this from day one" need here.
//
// Order-level, not per-item: the plan doesn't require per-item granularity, and
// per-item would mean tracking partial-order refund state (e.g. "3 of 5 items
// refunded") which is unnecessary complexity for this phase — order-level is the
// simpler, defensible choice.
enum RefundReasonCategory {
  DAMAGED
  WRONG_ITEM
  NOT_AS_DESCRIBED
  NO_LONGER_NEEDED
  OTHER
}

// REQUESTED is the only starting state. UNDER_REVIEW is an optional intermediate an
// admin can move into before deciding (e.g. to signal "looking into it" without
// committing to approve/reject yet) — both REQUESTED and UNDER_REVIEW can go straight
// to APPROVED or REJECTED. APPROVED/REJECTED are terminal for this phase; there's no
// "reopen" action.
enum RefundRequestStatus {
  REQUESTED
  UNDER_REVIEW
  APPROVED
  REJECTED
}

// One refund request per order at a time — refund-service.ts rejects creating a new
// request for an order that already has an open (REQUESTED/UNDER_REVIEW) one, enforced
// at the application layer (mirrors the InsufficientStockError conditional-update
// pattern in spirit, not literally — this is a plain pre-check + create, not a
// concurrent-decrement race, so no DB-level constraint is warranted here).
model RefundRequest {
  id String @id @default(cuid())

  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Restrict)

  requestedByUserId String
  requestedBy       User   @relation("RefundRequestsMade", fields: [requestedByUserId], references: [id], onDelete: Restrict)

  reasonCategory RefundReasonCategory
  reasonDetail   String?

  status RefundRequestStatus @default(REQUESTED)

  // Written by the admin action that resolves the request (approve/reject).
  // Customer-visible — see docs comment on the customer-facing view in
  // refund-service.ts: an adminNote explaining a rejection (or approval) is only
  // useful to the customer if they can actually see it, so it's surfaced on
  // /account/orders/[id] and any refund-request detail the customer can read. There is
  // no separate internal-only note field in this phase (unlike Order.internalNote) —
  // the plan doesn't call for one and admins already have the full status history.
  adminNote String?

  reviewedByUserId String?
  reviewedBy       User?   @relation("RefundRequestsReviewed", fields: [reviewedByUserId], references: [id], onDelete: SetNull)
  reviewedAt       DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  statusHistory RefundRequestStatusHistory[]

  @@index([orderId])
  @@index([requestedByUserId])
  @@index([status])
}

// Full audit trail for `RefundRequest.status` changes — same rigor/shape as Phase 9's
// OrderStatusHistory (actor/previous/new/reason/timestamp), per the cross-cutting
// standards' emphasis on auditability for admin actions. `fromStatus` is null only for
// the system-authored initial row written at request creation; `actorId` is null for
// that same row (the customer creates the request, not an admin acting on it) and set
// for every admin-initiated transition thereafter.
model RefundRequestStatusHistory {
  id         String                @id @default(cuid())
  fromStatus RefundRequestStatus?
  toStatus   RefundRequestStatus
  note       String?
  createdAt  DateTime              @default(now())

  refundRequestId String
  refundRequest   RefundRequest @relation(fields: [refundRequestId], references: [id], onDelete: Cascade)

  actorId String?
  actor   User?   @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([refundRequestId])
  @@index([actorId])
}

// Phase 7: Cart & Wishlist (Server-Aware). Guest carts remain localStorage-only
// (src/stores/cart-store.ts) — these models exist purely to give a logged-in user a
// server-persisted cart, mirroring the client shape ({productId, quantity}, no price
// snapshot — price always comes live from Product at read time, same principle as the
// client store). 1:1 Cart per User is the simplest model that satisfies "a user has one
// cart"; created lazily on first use, not at registration.
model Cart {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  items CartItem[]
}

model CartItem {
  id        String   @id @default(cuid())
  quantity  Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cartId String
  cart   Cart   @relation(fields: [cartId], references: [id], onDelete: Cascade)

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  // Nullable — set only when the customer selected a variant (size/color); null for a
  // plain, non-variant product line (the majority case). DB-level dedup here is a pair
  // of hand-added PARTIAL unique indexes (Prisma's schema DSL has no WHERE-clause
  // syntax, same gap as the CHECK-constraint cases elsewhere in this schema) rather
  // than a plain `@@unique([cartId, productId])` — because a plain composite unique
  // would either (a) block two DIFFERENT variants of the same product coexisting in
  // one cart (if variantId were included) or (b) not exist at all for the variantId
  // column's NULL case (Postgres treats NULL as never-equal in a plain unique index,
  // so two non-variant rows for the same product could otherwise both be created). See
  // the migration SQL: one partial index for `variantId IS NULL` (one row per product,
  // exactly the original invariant, preserved unchanged), one for `variantId IS NOT
  // NULL` (one row per product+variant combination).
  variantId String?
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([variantId])
}

// Same shape/rationale as Cart/CartItem. WishlistItem has no quantity — a product is
// either on the wishlist or it isn't.
model Wishlist {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  items WishlistItem[]
}

model WishlistItem {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  wishlistId String
  wishlist   Wishlist @relation(fields: [wishlistId], references: [id], onDelete: Cascade)

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  // DB-level authoritative duplicate-prevention (Phase 7 requirement) — enforced here,
  // not just client-side. wishlistService.addItem relies on this constraint (upsert /
  // catch P2002) so two concurrent POSTs of the same product can never create two rows.
  @@unique([wishlistId, productId])
  @@index([productId])
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

// Product reviews. Moderation-gated (PENDING by default) — only APPROVED reviews are
// ever shown on the storefront or counted in a product's aggregate rating; PENDING/
// REJECTED are visible only to the reviewing admin (reviews.manage permission) and to
// the review's own author. `verifiedPurchase` is computed server-side at creation time
// (does the author have a DELIVERED order containing this product?) and never trusted
// from the client — same "server is authoritative" principle as OrderItem pricing. No
// separate status-history table (unlike RefundRequest/Order): review moderation isn't a
// financial or security-critical operation, so a single overwritable `status` field is
// proportionate — see docs/ai/BUSINESS_RULES.md.
model Review {
  id      String @id @default(cuid())
  rating  Int // 1-5, enforced by a DB CHECK constraint (see migration) and zod at the API layer.
  title   String?
  body    String

  verifiedPurchase Boolean @default(false)
  status           ReviewStatus @default(PENDING)

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // One review per user per product — DB-level authoritative, same pattern as
  // WishlistItem's @@unique([wishlistId, productId]).
  @@unique([productId, userId])
  @@index([productId, status])
  @@index([userId])
}

enum CouponType {
  PERCENTAGE
  FIXED
}

// Coupons/discounts. Deliberately scoped to order-level, code-based discounts only —
// no product/category eligibility restrictions in this phase (would add real
// complexity — a join table + storefront eligibility-checking UI — with no concrete
// business requirement driving it yet; revisit if/when the business needs
// category-restricted promotions). One coupon code per order (see Order.couponCode /
// CouponRedemption). `timesUsed` is the authoritative global-usage counter,
// incremented via the same atomic-conditional-UPDATE pattern as Inventory.quantity
// (see coupon-repository.ts `redeemAtomically`) — never a naive read-then-write, so
// concurrent checkouts can't both redeem the last unit of a limited coupon.
model Coupon {
  id    String     @id @default(cuid())
  code  String     @unique
  type  CouponType
  value Decimal    @db.Decimal(12, 2) // percentage (0-100) or a fixed currency amount, per `type`

  minOrderAmount    Decimal? @db.Decimal(12, 2)
  maxDiscountAmount Decimal? @db.Decimal(12, 2) // caps a PERCENTAGE discount; ignored for FIXED

  startsAt DateTime?
  endsAt   DateTime?

  usageLimit     Int? // null = unlimited
  timesUsed      Int  @default(0)
  perCustomerLimit Int? // null = unlimited; enforced by counting CouponRedemption rows per user

  active Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  redemptions CouponRedemption[]

  @@index([active])
}

// One row per successful redemption — the audit trail for coupon usage, and the
// source of truth `coupon-service.ts` counts against for `perCustomerLimit`. Never
// deleted; a coupon can be deactivated (Coupon.active = false) but not hard-deleted
// once it has redemptions, so this table's history stays intact (same "historical
// record must survive" principle as OrderItem/InventoryTransaction).
model CouponRedemption {
  id String @id @default(cuid())

  couponId String
  coupon   Coupon @relation(fields: [couponId], references: [id], onDelete: Restrict)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)

  orderId String @unique
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Restrict)

  amount Decimal @db.Decimal(12, 2) // the actual discount applied, snapshotted

  createdAt DateTime @default(now())

  @@index([couponId, userId])
}

// Phase 11: Quote Requests (spec §19). Formalizes the previously-cosmetic `/quote`
// form into a real, persisted B2B-style request workflow — a REQUEST, not an
// authoritative price: the customer/guest states what they want and (optionally) what
// price they'd hope for, and an admin responds with real pricing before anything can
// become an order.
//
// Lifecycle implemented (a deliberately trimmed subset of the plan's full
// NEW → REVIEWING → QUOTED → ACCEPTED/DECLINED/EXPIRED → CONVERTED — EXPIRED is
// dropped: nothing in this phase runs a background job that could ever set it, so
// modeling it now would be an unused enum value, not a real feature):
//   NEW        — just submitted, nothing reviewed yet.
//   REVIEWING  — optional intermediate an admin can move into (mirrors
//                RefundRequestStatus.UNDER_REVIEW) before pricing it.
//   QUOTED     — an admin has set quotedUnitPrice on every item and responded
//                (quote-service.ts `respond`).
//   ACCEPTED   — the customer (ownership-checked, their own quote) or an admin
//                (e.g. phone confirmation) has agreed to the quoted pricing. This is
//                NOT the same as an order existing yet — see the conversion comment
//                below.
//   DECLINED   — terminal rejection, by either side, from NEW/REVIEWING/QUOTED.
//   CONVERTED  — an admin has run quote-service.ts `convertToOrder`, creating a real
//                Order priced at the locked-in quotedUnitPrice values.
enum QuoteStatus {
  NEW
  REVIEWING
  QUOTED
  ACCEPTED
  DECLINED
  CONVERTED
}

// Submitter is EITHER a logged-in User (`userId` set) OR a guest (`userId` null,
// contact fields carry everything) — quotes, unlike checkout (Phase 8's auth-required
// decision), are a legitimate guest-submittable business inquiry per
// docs/IMPLEMENTATION_PLAN.md Phase 11 ("a business inquiry doesn't necessarily require
// an account"). Contact fields are always populated (even for a logged-in submitter,
// inline at submission time — mirroring Order's shipping-address snapshot pattern: a
// quote records what the submitter typed at that moment, not a live pointer to
// User.name/email that could drift later).
//
// Conversion (`convertToOrder` in quote-service.ts) requires `userId` to be set — a
// guest quote cannot self-convert into an Order, since Order.userId is required and
// there is no session to attach it to. A guest whose quote needs converting must
// register/log in first (at which point a new quote could be submitted, or — out of
// this phase's scope — an admin could handle it manually outside the system). This is
// a deliberate, documented limitation, not an oversight.
model Quote {
  id String @id @default(cuid())

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  contactName    String
  contactEmail   String
  contactPhone   String?
  contactCompany String?

  // The customer's free-text message/requirements — distinct from any per-item note.
  customerNote String?

  status QuoteStatus @default(NEW)

  // Currency snapshot, taken from the first quoted item's product at submission time
  // (mirrors Order.currency) — see docs/DECISIONS.md D-006, still an open business
  // decision; USD remains the development-time default.
  currency String @default("USD")

  // Written by the admin action that responds with pricing (`respond`) — customer-
  // visible, same rationale as RefundRequest.adminNote: a note only an admin can read
  // isn't useful to the customer deciding whether to accept.
  adminNote String?

  // Set only by `convertToOrder`, atomically with Order creation (same DB transaction
  // — see order-service.ts `createOrderFromPricedItems` `withinTransaction` hook). A
  // read-only reference once set; the Order itself is never mutated once created.
  convertedOrderId String? @unique
  convertedOrder   Order?  @relation(fields: [convertedOrderId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items         QuoteItem[]
  statusHistory QuoteStatusHistory[]

  @@index([userId])
  @@index([status])
  @@index([contactEmail])
}

// Every request-time identity field (productName/sku) is a SNAPSHOT taken at
// submission time, same rationale as OrderItem — a product renamed/re-SKU'd after a
// quote was submitted shouldn't change what the quote says was asked for.
// `requestedPrice` is customer-supplied and purely informational (never trusted as an
// authoritative price — cross-cutting standard); `quotedUnitPrice` is the ONLY price
// that can ever become an OrderItem.unitPrice on conversion, and is null until an
// admin sets it via `respond`. onDelete: Restrict on the Product relation, matching
// OrderItem, so a quoted-on product can't be hard-deleted out from under this record.
model QuoteItem {
  id String @id @default(cuid())

  quoteId String
  quote   Quote  @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  productName String
  sku         String?
  quantity    Int

  requestedPrice Decimal? @db.Decimal(12, 2)
  customerNote   String?

  quotedUnitPrice Decimal? @db.Decimal(12, 2)

  createdAt DateTime @default(now())

  @@index([quoteId])
  @@index([productId])
}

// Full audit trail for `Quote.status` changes — same shape/rationale as Phase 9/10's
// history models (actor/previous/new/note/timestamp). `fromStatus` is null only for
// the system-authored initial NEW row written at submission; `actorId` is null for
// that same row AND for a customer's own ACCEPTED/DECLINED transition (the customer is
// not an "admin actor" in the sense this field represents elsewhere — a customer
// acting on their own quote is still a real, session-verified user, but recording them
// via `actorId` would visually conflate "an admin did this" with "the customer did
// this" in the admin-facing timeline; see quote-service.ts `customerUpdateStatus`
// for where this history row is written without an actorId).
model QuoteStatusHistory {
  id         String       @id @default(cuid())
  fromStatus QuoteStatus?
  toStatus   QuoteStatus
  note       String?
  createdAt  DateTime     @default(now())

  quoteId String
  quote   Quote  @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  actorId String?
  actor   User?   @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([quoteId])
  @@index([actorId])
}

// Phase 12: CMS. `body` is a structured JSON array of typed content blocks (see
// src/lib/validations/cms.ts for the block shapes — heading / paragraph / faqItem
// today) rather than raw HTML or markdown-to-HTML. This is a deliberate XSS-prevention
// design choice (docs/IMPLEMENTATION_PLAN.md Phase 12, "sidestep most of the risk by
// construction"): the renderer (src/components/cms/page-renderer.tsx) only ever
// interprets known block fields as plain text through React (which escapes text nodes
// by default) — there is no `dangerouslySetInnerHTML` anywhere in this app, so there is
// no HTML-injection surface for admin-supplied CMS copy to exploit, regardless of what
// a compromised/malicious admin account submits. `published` gates the public read
// path (src/server/services/cms-page-service.ts `getPublishedBySlug`) — a draft page is
// never returned there, only through the admin-only methods.
model CMSPage {
  id        String   @id @default(cuid())
  slug      String   @unique
  title     String
  body      Json
  published Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  translations CMSPageTranslation[]

  @@index([published])
}

// Phase 17 (i18n): same pattern as ProductTranslation/CategoryTranslation. `body` is
// the same structured-JSON block shape as the base CMSPage.body (rendered as plain
// React text, never dangerouslySetInnerHTML — see CMSPage's own comment).
model CMSPageTranslation {
  id     String  @id @default(cuid())
  pageId String
  page   CMSPage @relation(fields: [pageId], references: [id], onDelete: Cascade)

  locale String

  title String
  body  Json
  slug  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([pageId, locale])
  @@unique([locale, slug])
  @@index([locale])
}

// Named slots a Banner can be assigned to. HOMEPAGE_HERO overrides the homepage hero's
// headline/subtext/CTA (src/components/home/hero-section.tsx); HOMEPAGE_PROMO is an
// optional promotional strip rendered only when an active one exists (see
// src/app/page.tsx) — both fall back to the existing static approved copy/design when
// no active banner is configured for the slot, so an empty Banner table never breaks
// the homepage (Phase 12 requirement).
enum BannerSlot {
  HOMEPAGE_HERO
  HOMEPAGE_PROMO
}

// All text fields (title/subtitle/ctaText) are rendered as plain React text — never as
// HTML — same XSS rationale as CMSPage above. `imageUrl`/`linkUrl` are validated
// server-side (src/lib/validations/cms.ts) to only accept http(s)/relative URLs,
// rejecting `javascript:`/`data:` schemes that could otherwise turn an href/src into a
// script-execution vector. Scheduling (`startsAt`/`endsAt`) is optional — a banner with
// neither is simply always eligible whenever `active` is true. `priority` breaks ties
// when more than one banner is active for the same slot (highest first).
model Banner {
  id       String     @id @default(cuid())
  slot     BannerSlot
  title    String
  subtitle String?
  imageUrl String?
  linkUrl  String?
  ctaText  String?
  active   Boolean    @default(false)
  priority Int        @default(0)
  startsAt DateTime?
  endsAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  translations BannerTranslation[]

  @@index([slot, active])
}

// Phase 17 (i18n): same pattern as the other translation models. No slug field here —
// Banner has no customer-facing URL of its own (linkUrl is an admin-supplied, already
// locale-agnostic destination).
model BannerTranslation {
  id       String @id @default(cuid())
  bannerId String
  banner   Banner @relation(fields: [bannerId], references: [id], onDelete: Cascade)

  locale String

  title    String
  subtitle String?
  ctaText  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([bannerId, locale])
  @@index([locale])
}

// Phase 15: Notifications. A small closed enum covering exactly the three trigger
// points wired up in this phase (order-service.ts `updateStatus`,
// refund-request-service.ts `updateStatus`, quote-service.ts `respond`) rather than a
// generic/open-ended event-type string — "no unnecessary abstraction" per
// docs/IMPLEMENTATION_PLAN.md cross-cutting standards. Add a new value here (and a new
// trigger call) if a future phase needs another notification-worthy event; don't
// generalize ahead of that need.
enum NotificationType {
  ORDER_STATUS_CHANGED
  REFUND_REQUEST_UPDATED
  QUOTE_RESPONSE
}

// What `relatedEntityId` points at, so the UI knows which detail page to link to
// (/account/orders/[id], /account/refund-requests/[id]-equivalent, /account/quotes/[id]).
enum NotificationEntityType {
  ORDER
  REFUND_REQUEST
  QUOTE
}

// In-app notifications only — see docs/DECISIONS.md D-011. `title`/`message` are
// plain, pre-rendered strings written at creation time (not re-derived later from the
// related entity's current state), same "snapshot, not a live pointer" principle as
// Order/Quote/RefundRequest's own snapshot fields: if the related order/refund/quote
// changes again later, this notification's text still describes the event it was
// actually created for. `relatedEntityType`/`relatedEntityId` are optional so the model
// isn't forced to always point somewhere, but every trigger point in this phase sets
// both. Real email delivery does NOT happen here or anywhere in this codebase yet
// (src/server/services/email-notifier.ts is a stub that only logs) — this table is the
// one real, working delivery channel this phase ships.
model Notification {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  type    NotificationType
  title   String
  message String

  relatedEntityType NotificationEntityType?
  relatedEntityId   String?

  read   Boolean   @default(false)
  readAt DateTime?

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([userId, read])
}

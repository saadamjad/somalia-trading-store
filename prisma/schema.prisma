// Prisma schema — Somalia Trading Store
// Phase 2: Category and Product only (entities that don't depend on auth).
// See docs/IMPLEMENTATION_PLAN.md for what each later phase adds.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum PurchasingMode {
  BUY_ONLINE
  QUOTE_ONLY
  BOTH
}

enum Availability {
  IN_STOCK
  LIMITED
  OUT_OF_STOCK
  MADE_TO_ORDER
}

// Phase 5: Inventory. Kept as a small, free-form-friendly enum per
// docs/IMPLEMENTATION_PLAN.md Phase 5 ("free text or a small enum — your call, keep it
// simple") — MANUAL_ADJUSTMENT covers ad-hoc admin corrections, RESTOCK/CORRECTION give
// admins meaningful categories to pick from, and ORDER_PLACED/ORDER_CANCELLED are the
// hooks Phase 8 (checkout) will use when it starts decrementing stock on order creation.
// A free-text `note` field on InventoryTransaction covers anything an enum can't.
enum InventoryChangeReason {
  MANUAL_ADJUSTMENT
  RESTOCK
  CORRECTION
  ORDER_PLACED
  ORDER_CANCELLED
}

model Category {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  description String
  shortDescription String
  image       String
  heroImage   String
  accentColor String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  parentId String?
  parent   Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: Restrict)
  children Category[] @relation("CategoryHierarchy")

  products Product[]

  @@index([parentId])
}

model Product {
  id          String   @id @default(cuid())
  slug        String   @unique
  sku         String?  @unique
  name        String
  description String
  shortDescription String

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  // Phase 4: free-text facet within a category (e.g. "Doors", "Rods"). Not a separate
  // table/relation — the old demo data modeled this as a plain string per product, and
  // Category nesting (parentId/children) already covers the "real subcategory as its own
  // entity" case if that's ever needed. Kept as a simple field to preserve the existing
  // filter/facet UI (src/config/filters.ts) with a minimal, non-breaking schema change.
  subcategory String?

  price           Decimal @db.Decimal(12, 2)
  compareAtPrice  Decimal? @db.Decimal(12, 2)
  currency        String  @default("USD")
  priceUnit       String?

  images         String[]
  specifications Json     @default("{}")
  tags           String[]

  purchasingMode PurchasingMode @default(BUY_ONLINE)
  availability   Availability   @default(IN_STOCK)
  featured       Boolean        @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  inventory             Inventory?
  inventoryTransactions InventoryTransaction[]

  // Phase 7: Cart & Wishlist.
  cartItems     CartItem[]
  wishlistItems WishlistItem[]

  // Phase 8: Checkout & Order Placement. Reference-only — see OrderItem's comment.
  orderItems OrderItem[]

  // Phase 11: Quote Requests. Reference-only — see QuoteItem's own comment.
  quoteItems QuoteItem[]

  @@index([categoryId])
  @@index([featured])
  @@index([availability])
  @@index([subcategory])
}

// Phase 3: Authentication & Authorization.
// JWT session strategy (Credentials provider only) — no Account/Session/VerificationToken
// tables; see docs/DECISIONS.md D-004 and docs/IMPLEMENTATION_PLAN.md Phase 3.
model Role {
  id          String   @id @default(cuid())
  name        String   @unique
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users             User[]
  rolePermissions   RolePermission[]
}

model Permission {
  id        String   @id @default(cuid())
  key       String   @unique
  createdAt DateTime @default(now())

  rolePermissions RolePermission[]
}

model RolePermission {
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  passwordHash  String
  name          String
  phone         String?
  emailVerified DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  roleId String
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Restrict)

  passwordResetTokens   PasswordResetToken[]
  inventoryTransactions InventoryTransaction[]
  addresses             Address[]

  // Phase 7: Cart & Wishlist. 1:1 per user — simplest model that satisfies "a user has
  // one cart" / "a user has one wishlist"; both are created lazily on first use
  // (cart-service.ts / wishlist-service.ts getOrCreateForUser) rather than at
  // registration, so most users never get an empty row.
  cart     Cart?
  wishlist Wishlist?

  // Phase 8: Checkout & Order Placement.
  orders Order[]

  // Phase 9: Order Management. Nullable actor on both — see the history models' own
  // comments for why (system-authored initial rows have no actor).
  orderStatusHistoryActions   OrderStatusHistory[]
  paymentStatusHistoryActions PaymentStatusHistory[]

  // Phase 10: Refund/Return Workflow. Two distinct relations to RefundRequest (the
  // customer who requested vs. the admin who reviewed) plus the status-history actor —
  // named relations required since there's more than one FK from User to RefundRequest.
  refundRequestsMade                RefundRequest[]               @relation("RefundRequestsMade")
  refundRequestsReviewed             RefundRequest[]               @relation("RefundRequestsReviewed")
  refundRequestStatusHistoryActions RefundRequestStatusHistory[]

  // Phase 11: Quote Requests. Nullable — a quote may be submitted by a guest (no
  // userId at all, see Quote's own comment) rather than every quote having an owning
  // user. `quoteStatusHistoryActions` is the admin actor on QuoteStatusHistory rows
  // (nullable there too, for the system-authored initial NEW row).
  quotes                     Quote[]
  quoteStatusHistoryActions  QuoteStatusHistory[]

  @@index([roleId])
}

// Phase 6: Customer Account. Multiple addresses per user (e.g. home + office); Phase 8
// (checkout) will read `isDefault` to preselect a shipping address. Every read/write
// path (src/server/services/address-service.ts) must scope by the owning userId taken
// from the server-verified session — never a client-supplied userId — per
// docs/IMPLEMENTATION_PLAN.md cross-cutting standards and the Phase 6 IDOR requirement.
// No `postalCode` requirement — Somalia addressing doesn't always use one.
model Address {
  id            String   @id @default(cuid())
  recipientName String
  phone         String
  line1         String
  line2         String?
  city          String
  region        String?
  postalCode    String?
  country       String
  isDefault     Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Phase 5: Inventory. 1:1 with Product. `quantity` must never go negative — enforced
// both at the application layer (inventory-service.ts, atomic conditional UPDATE inside
// a transaction) and at the DB layer via a CHECK constraint. Prisma's schema DSL has no
// native syntax for arbitrary CHECK constraints at this version, so the constraint is
// added by hand-editing the generated migration.sql after `prisma migrate dev` — see
// prisma/migrations/<timestamp>_add_inventory/migration.sql and the note in
// docs/DECISIONS.md.
model Inventory {
  id                String   @id @default(cuid())
  quantity          Int      @default(0)
  lowStockThreshold Int      @default(10)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  productId String  @unique
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  transactions InventoryTransaction[]
}

// Full audit log of every stock change: who (actor), what product, previous/adjustment/
// new quantity, why (reason + optional free-text note), and when. Never mutated or
// deleted — one row per adjustment, per docs/IMPLEMENTATION_PLAN.md cross-cutting
// standards ("Inventory adjustments are logged with actor, previous quantity,
// adjustment, new quantity, reason, and timestamp").
model InventoryTransaction {
  id               String                @id @default(cuid())
  previousQuantity Int
  adjustment       Int
  newQuantity      Int
  reason           InventoryChangeReason
  note             String?
  createdAt        DateTime              @default(now())

  inventoryId String
  inventory   Inventory @relation(fields: [inventoryId], references: [id], onDelete: Cascade)

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  actorId String
  actor   User   @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([inventoryId])
  @@index([productId])
  @@index([actorId])
}

// Phase 8: Checkout & Order Placement.
// D-007 (docs/DECISIONS.md): no payment gateway is chosen yet, so every order is
// created PENDING/NOT_PAID, unconditionally, forever, in this phase. CONFIRMED/
// PROCESSING/SHIPPED/DELIVERED/CANCELLED and PAID/REFUNDED/FAILED exist here only as
// future-proofing for Phase 9/10 — nothing in Phase 8's checkout flow can ever produce
// them; order-service.createOrder hardcodes PENDING/NOT_PAID and nothing else writes
// to these fields yet.
enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  NOT_PAID
  PAID
  REFUNDED
  FAILED
}

// Order/OrderItem intentionally do NOT reuse CartItem's { productId, quantity } shape
// (docs/PROJECT_AUDIT.md data-integrity section) — an order must remain accurate
// forever even after the referenced Product's price/name/sku changes later. Shipping
// address is copied onto the Order as plain fields (not a live Address FK) for the same
// reason: editing/deleting the source Address later must never alter what a past order
// shows as "shipped to". `taxAmount`/`shippingAmount` are deliberately not modeled yet
// (D-008 — both deferred); `subtotal`/`total` are equal today by construction, kept as
// two fields so tax/shipping can be added later (`total = subtotal + tax + shipping`)
// without a breaking schema change.
model Order {
  id          String        @id @default(cuid())
  orderNumber String        @unique
  status      OrderStatus   @default(PENDING)
  paymentStatus PaymentStatus @default(NOT_PAID)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)

  // Shipping address snapshot — copied at order-creation time from the customer's
  // chosen Address (or inline input), never a live FK. See comment above.
  shippingRecipientName String
  shippingPhone         String
  shippingLine1         String
  shippingLine2         String?
  shippingCity          String
  shippingRegion        String?
  shippingPostalCode    String?
  shippingCountry       String

  subtotal Decimal @db.Decimal(12, 2)
  total    Decimal @db.Decimal(12, 2)
  currency String  @default("USD")

  customerNote String?

  // Phase 9: Order Management. Admin-only working note — visible only in /admin/orders,
  // never surfaced to the customer. A single overwritable field, not a log: simpler than
  // a separate notes model, at the cost of losing history if an admin overwrites it. If a
  // running log ever becomes a real requirement, promote this to its own model then —
  // not needed for the "internal notes field" ask in the Phase 9 plan today.
  internalNote String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items         OrderItem[]
  statusHistory OrderStatusHistory[]
  paymentStatusHistory PaymentStatusHistory[]

  // Phase 10: Refund/Return Workflow. See RefundRequest's own comment — order-level,
  // so a single order may accumulate multiple requests over time (though only one may
  // be open/unresolved at once, enforced in refund-service.ts).
  refundRequests RefundRequest[]

  // Phase 11: Quote Requests. Reverse side of Quote.convertedOrderId — set only when
  // this order was created via quote-service.convertToOrder rather than normal
  // checkout. No FK columns live on Order itself for this; Quote holds the FK (see
  // Quote's own comment).
  convertedFromQuote Quote?

  @@index([userId])
  @@index([orderNumber])
}

// Phase 9: Order Management — full audit trail for `Order.status` changes, per
// docs/IMPLEMENTATION_PLAN.md Phase 9 ("full audit trail") and the same spirit as
// InventoryTransaction (cross-cutting standard: actor/previous/new/reason/timestamp).
// One row per transition, never mutated/deleted. `fromStatus` is null only for the
// very first row written at order creation (PENDING has no prior status); `actorId` is
// null for that same row (the system, not an admin, creates a PENDING order) and set
// for every admin-initiated change thereafter. Kept as its own model rather than a
// generic polymorphic "history" table — two small, clearly-named models
// (OrderStatusHistory / PaymentStatusHistory) are easier to query and reason about than
// one shared table with a discriminator column, for the two fields that need this today.
model OrderStatusHistory {
  id         String       @id @default(cuid())
  fromStatus OrderStatus?
  toStatus   OrderStatus
  note       String?
  createdAt  DateTime     @default(now())

  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  actorId String?
  actor   User?   @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([actorId])
}

// Phase 9: parallel audit trail for `Order.paymentStatus`. No code path in this phase
// (or any prior phase) ever changes paymentStatus — D-007, no payment gateway exists
// yet — so today this only ever gets the one row written at order creation
// (fromStatus: null, toStatus: NOT_PAID, actorId: null). It exists now, alongside
// OrderStatusHistory, so a future payment-gateway integration has an audit trail to
// write into from day one instead of retrofitting one later. Deliberately a SEPARATE
// model from OrderStatusHistory (not a shared table) — this is the same structural
// guardrail as the Order model itself keeping `status`/`paymentStatus` as two
// independent fields: nothing about this schema invites coupling the two histories
// together either.
model PaymentStatusHistory {
  id         String         @id @default(cuid())
  fromStatus PaymentStatus?
  toStatus   PaymentStatus
  note       String?
  createdAt  DateTime       @default(now())

  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  actorId String?
  actor   User?   @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([actorId])
}

// Every pricing/identity field here is a SNAPSHOT taken at order-creation time —
// productName/sku/unitPrice/lineTotal are never re-derived from the live Product row
// afterward (docs/IMPLEMENTATION_PLAN.md cross-cutting standards). `productId` is kept
// as a reference-only FK (e.g. for admins to jump to the current product page) — never
// the source of truth for what was actually purchased. onDelete: Restrict on the
// Product relation means a product that has ever been ordered can't be hard-deleted,
// which keeps that reference meaningful for as long as it exists.
model OrderItem {
  id String @id @default(cuid())

  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  productName String
  sku         String?
  unitPrice   Decimal @db.Decimal(12, 2)
  quantity    Int
  lineTotal   Decimal @db.Decimal(12, 2)

  createdAt DateTime @default(now())

  @@index([orderId])
  @@index([productId])
}

// Phase 10: Refund/Return Workflow (spec §7; docs/DECISIONS.md D-007). This is a
// REQUEST workflow only — no payment gateway exists yet, so nothing here ever moves
// money or touches `Order.paymentStatus`. `RefundRequestStatus` is the request's own
// lifecycle (did we, as a business, agree the customer should get their money back)
// and is deliberately never written to `Order.paymentStatus` by any code path — see
// refund-service.ts. A genuine "has this actually been refunded in the real world"
// concept (`PaymentRefundStatus`) is intentionally NOT modeled yet: `Order.paymentStatus`
// already reserves a `REFUNDED` value for whenever a payment gateway exists (Phase 8
// schema comment), so adding a second, parallel, always-unset enum here would be pure
// scope creep with no code path that could ever set it — unlike Phase 9's
// PaymentStatusHistory, which existed to give a *future* gateway integration an audit
// trail to write into. There's no equivalent "write into this from day one" need here.
//
// Order-level, not per-item: the plan doesn't require per-item granularity, and
// per-item would mean tracking partial-order refund state (e.g. "3 of 5 items
// refunded") which is unnecessary complexity for this phase — order-level is the
// simpler, defensible choice.
enum RefundReasonCategory {
  DAMAGED
  WRONG_ITEM
  NOT_AS_DESCRIBED
  NO_LONGER_NEEDED
  OTHER
}

// REQUESTED is the only starting state. UNDER_REVIEW is an optional intermediate an
// admin can move into before deciding (e.g. to signal "looking into it" without
// committing to approve/reject yet) — both REQUESTED and UNDER_REVIEW can go straight
// to APPROVED or REJECTED. APPROVED/REJECTED are terminal for this phase; there's no
// "reopen" action.
enum RefundRequestStatus {
  REQUESTED
  UNDER_REVIEW
  APPROVED
  REJECTED
}

// One refund request per order at a time — refund-service.ts rejects creating a new
// request for an order that already has an open (REQUESTED/UNDER_REVIEW) one, enforced
// at the application layer (mirrors the InsufficientStockError conditional-update
// pattern in spirit, not literally — this is a plain pre-check + create, not a
// concurrent-decrement race, so no DB-level constraint is warranted here).
model RefundRequest {
  id String @id @default(cuid())

  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Restrict)

  requestedByUserId String
  requestedBy       User   @relation("RefundRequestsMade", fields: [requestedByUserId], references: [id], onDelete: Restrict)

  reasonCategory RefundReasonCategory
  reasonDetail   String?

  status RefundRequestStatus @default(REQUESTED)

  // Written by the admin action that resolves the request (approve/reject).
  // Customer-visible — see docs comment on the customer-facing view in
  // refund-service.ts: an adminNote explaining a rejection (or approval) is only
  // useful to the customer if they can actually see it, so it's surfaced on
  // /account/orders/[id] and any refund-request detail the customer can read. There is
  // no separate internal-only note field in this phase (unlike Order.internalNote) —
  // the plan doesn't call for one and admins already have the full status history.
  adminNote String?

  reviewedByUserId String?
  reviewedBy       User?   @relation("RefundRequestsReviewed", fields: [reviewedByUserId], references: [id], onDelete: SetNull)
  reviewedAt       DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  statusHistory RefundRequestStatusHistory[]

  @@index([orderId])
  @@index([requestedByUserId])
  @@index([status])
}

// Full audit trail for `RefundRequest.status` changes — same rigor/shape as Phase 9's
// OrderStatusHistory (actor/previous/new/reason/timestamp), per the cross-cutting
// standards' emphasis on auditability for admin actions. `fromStatus` is null only for
// the system-authored initial row written at request creation; `actorId` is null for
// that same row (the customer creates the request, not an admin acting on it) and set
// for every admin-initiated transition thereafter.
model RefundRequestStatusHistory {
  id         String                @id @default(cuid())
  fromStatus RefundRequestStatus?
  toStatus   RefundRequestStatus
  note       String?
  createdAt  DateTime              @default(now())

  refundRequestId String
  refundRequest   RefundRequest @relation(fields: [refundRequestId], references: [id], onDelete: Cascade)

  actorId String?
  actor   User?   @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([refundRequestId])
  @@index([actorId])
}

// Phase 7: Cart & Wishlist (Server-Aware). Guest carts remain localStorage-only
// (src/stores/cart-store.ts) — these models exist purely to give a logged-in user a
// server-persisted cart, mirroring the client shape ({productId, quantity}, no price
// snapshot — price always comes live from Product at read time, same principle as the
// client store). 1:1 Cart per User is the simplest model that satisfies "a user has one
// cart"; created lazily on first use, not at registration.
model Cart {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  items CartItem[]
}

model CartItem {
  id        String   @id @default(cuid())
  quantity  Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cartId String
  cart   Cart   @relation(fields: [cartId], references: [id], onDelete: Cascade)

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  // DB-level authoritative dedup: a product can only appear once per cart. Server-side
  // "add" is always an upsert against this constraint, never a blind insert.
  @@unique([cartId, productId])
  @@index([productId])
}

// Same shape/rationale as Cart/CartItem. WishlistItem has no quantity — a product is
// either on the wishlist or it isn't.
model Wishlist {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  items WishlistItem[]
}

model WishlistItem {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  wishlistId String
  wishlist   Wishlist @relation(fields: [wishlistId], references: [id], onDelete: Cascade)

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  // DB-level authoritative duplicate-prevention (Phase 7 requirement) — enforced here,
  // not just client-side. wishlistService.addItem relies on this constraint (upsert /
  // catch P2002) so two concurrent POSTs of the same product can never create two rows.
  @@unique([wishlistId, productId])
  @@index([productId])
}

// Phase 11: Quote Requests (spec §19). Formalizes the previously-cosmetic `/quote`
// form into a real, persisted B2B-style request workflow — a REQUEST, not an
// authoritative price: the customer/guest states what they want and (optionally) what
// price they'd hope for, and an admin responds with real pricing before anything can
// become an order.
//
// Lifecycle implemented (a deliberately trimmed subset of the plan's full
// NEW → REVIEWING → QUOTED → ACCEPTED/DECLINED/EXPIRED → CONVERTED — EXPIRED is
// dropped: nothing in this phase runs a background job that could ever set it, so
// modeling it now would be an unused enum value, not a real feature):
//   NEW        — just submitted, nothing reviewed yet.
//   REVIEWING  — optional intermediate an admin can move into (mirrors
//                RefundRequestStatus.UNDER_REVIEW) before pricing it.
//   QUOTED     — an admin has set quotedUnitPrice on every item and responded
//                (quote-service.ts `respond`).
//   ACCEPTED   — the customer (ownership-checked, their own quote) or an admin
//                (e.g. phone confirmation) has agreed to the quoted pricing. This is
//                NOT the same as an order existing yet — see the conversion comment
//                below.
//   DECLINED   — terminal rejection, by either side, from NEW/REVIEWING/QUOTED.
//   CONVERTED  — an admin has run quote-service.ts `convertToOrder`, creating a real
//                Order priced at the locked-in quotedUnitPrice values.
enum QuoteStatus {
  NEW
  REVIEWING
  QUOTED
  ACCEPTED
  DECLINED
  CONVERTED
}

// Submitter is EITHER a logged-in User (`userId` set) OR a guest (`userId` null,
// contact fields carry everything) — quotes, unlike checkout (Phase 8's auth-required
// decision), are a legitimate guest-submittable business inquiry per
// docs/IMPLEMENTATION_PLAN.md Phase 11 ("a business inquiry doesn't necessarily require
// an account"). Contact fields are always populated (even for a logged-in submitter,
// inline at submission time — mirroring Order's shipping-address snapshot pattern: a
// quote records what the submitter typed at that moment, not a live pointer to
// User.name/email that could drift later).
//
// Conversion (`convertToOrder` in quote-service.ts) requires `userId` to be set — a
// guest quote cannot self-convert into an Order, since Order.userId is required and
// there is no session to attach it to. A guest whose quote needs converting must
// register/log in first (at which point a new quote could be submitted, or — out of
// this phase's scope — an admin could handle it manually outside the system). This is
// a deliberate, documented limitation, not an oversight.
model Quote {
  id String @id @default(cuid())

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  contactName    String
  contactEmail   String
  contactPhone   String?
  contactCompany String?

  // The customer's free-text message/requirements — distinct from any per-item note.
  customerNote String?

  status QuoteStatus @default(NEW)

  // Currency snapshot, taken from the first quoted item's product at submission time
  // (mirrors Order.currency) — see docs/DECISIONS.md D-006, still an open business
  // decision; USD remains the development-time default.
  currency String @default("USD")

  // Written by the admin action that responds with pricing (`respond`) — customer-
  // visible, same rationale as RefundRequest.adminNote: a note only an admin can read
  // isn't useful to the customer deciding whether to accept.
  adminNote String?

  // Set only by `convertToOrder`, atomically with Order creation (same DB transaction
  // — see order-service.ts `createOrderFromPricedItems` `withinTransaction` hook). A
  // read-only reference once set; the Order itself is never mutated once created.
  convertedOrderId String? @unique
  convertedOrder   Order?  @relation(fields: [convertedOrderId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items         QuoteItem[]
  statusHistory QuoteStatusHistory[]

  @@index([userId])
  @@index([status])
  @@index([contactEmail])
}

// Every request-time identity field (productName/sku) is a SNAPSHOT taken at
// submission time, same rationale as OrderItem — a product renamed/re-SKU'd after a
// quote was submitted shouldn't change what the quote says was asked for.
// `requestedPrice` is customer-supplied and purely informational (never trusted as an
// authoritative price — cross-cutting standard); `quotedUnitPrice` is the ONLY price
// that can ever become an OrderItem.unitPrice on conversion, and is null until an
// admin sets it via `respond`. onDelete: Restrict on the Product relation, matching
// OrderItem, so a quoted-on product can't be hard-deleted out from under this record.
model QuoteItem {
  id String @id @default(cuid())

  quoteId String
  quote   Quote  @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  productName String
  sku         String?
  quantity    Int

  requestedPrice Decimal? @db.Decimal(12, 2)
  customerNote   String?

  quotedUnitPrice Decimal? @db.Decimal(12, 2)

  createdAt DateTime @default(now())

  @@index([quoteId])
  @@index([productId])
}

// Full audit trail for `Quote.status` changes — same shape/rationale as Phase 9/10's
// history models (actor/previous/new/note/timestamp). `fromStatus` is null only for
// the system-authored initial NEW row written at submission; `actorId` is null for
// that same row AND for a customer's own ACCEPTED/DECLINED transition (the customer is
// not an "admin actor" in the sense this field represents elsewhere — a customer
// acting on their own quote is still a real, session-verified user, but recording them
// via `actorId` would visually conflate "an admin did this" with "the customer did
// this" in the admin-facing timeline; see quote-service.ts `customerUpdateStatus`
// for where this history row is written without an actorId).
model QuoteStatusHistory {
  id         String       @id @default(cuid())
  fromStatus QuoteStatus?
  toStatus   QuoteStatus
  note       String?
  createdAt  DateTime     @default(now())

  quoteId String
  quote   Quote  @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  actorId String?
  actor   User?   @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([quoteId])
  @@index([actorId])
}

# Copy this file to .env.local for local development.
# Never commit real values — this file must only ever contain placeholders.
#
# In production (Vercel), these are NOT read from a file — set them in the
# Vercel project's Environment Variables settings instead. See docs/DEPLOYMENT.md.

# --- Database (Phase 2) ---
# Local dev: plain connection string to your local Postgres, no pooler involved.
DATABASE_URL="postgresql://user:password@localhost:5432/somalia_trading_store"

# Production only (Supabase): DATABASE_URL becomes the pooled "Transaction pooler"
# connection string (port 6543) — copy it exactly as Supabase's dashboard presents it,
# under Project Settings > Database > Connection pooling. This is what the app queries
# through at runtime; using the pooler here is required in serverless deployments,
# otherwise each concurrent request can open its own direct Postgres connection and
# exhaust the database's connection limit under real traffic.
#
# DIRECT_URL: the non-pooled connection string (port 5432, same dashboard page).
# `prisma migrate deploy` needs this — the pooler's transaction mode doesn't support
# the session-level locking migrations require. Only needed where migrations run
# (locally against production, or a CI/manual deploy step) — leave unset for local dev.
# DIRECT_URL="postgresql://postgres:[password]@[host]:5432/postgres"

# --- Authentication (Phase 3) ---
# Auth.js session encryption secret. Generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-generated-random-secret"

# Base URL Auth.js uses for callbacks. Update per environment —
# in production this is your real deployed URL (e.g. https://somaliatrading.com),
# not localhost.
AUTH_URL="http://localhost:3000"
